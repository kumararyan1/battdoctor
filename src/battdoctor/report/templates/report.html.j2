<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  <script>{{ plotlyjs | safe }}</script>
  <style>
    :root {
      color-scheme: dark;
      --bg: #0d1117;
      --panel: #161b22;
      --panel-alt: #1c2330;
      --border: #30363d;
      --text: #e6edf3;
      --muted: #8b949e;
      --accent: #58a6ff;
      --good: #3fb950;
      --warn: #d29922;
      --bad: #f85149;
      --purple: #d2a8ff;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background:
        radial-gradient(circle at top left, rgba(88, 166, 255, 0.08), transparent 34rem),
        var(--bg);
      color: var(--text);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      font-size: 14px;
      line-height: 1.5;
    }
    .wrap {
      max-width: 1440px;
      margin: 0 auto;
      padding: 32px 24px 48px;
    }
    header {
      margin-bottom: 24px;
    }
    h1 {
      margin: 0;
      font-size: 30px;
      line-height: 1.2;
      letter-spacing: -0.02em;
    }
    .subtitle {
      color: var(--muted);
      margin: 8px 0 0;
      font-size: 14px;
      max-width: 900px;
    }
    h2 {
      font-size: 17px;
      margin: 0 0 12px;
      letter-spacing: -0.01em;
    }
    .metrics {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
      gap: 12px;
      margin-bottom: 20px;
    }
    .metric, .panel, .chart-card, .empty {
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.02), transparent), var(--panel);
      border: 1px solid var(--border);
      border-radius: 12px;
    }
    .metric {
      padding: 14px 16px;
      min-height: 86px;
    }
    .metric .label {
      color: var(--muted);
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .metric .value {
      margin-top: 8px;
      font-size: 22px;
      font-weight: 650;
      letter-spacing: -0.02em;
      word-break: break-word;
    }
    .metric .value.small {
      font-size: 15px;
      line-height: 1.35;
      font-weight: 500;
    }
    .warnings {
      margin-bottom: 20px;
      padding: 14px 18px;
    }
    .warnings h2 {
      margin-bottom: 8px;
      color: var(--warn);
    }
    .warnings ul {
      margin: 0;
      padding-left: 20px;
      color: #e3b341;
    }
    .charts {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(430px, 1fr));
      gap: 16px;
      margin-bottom: 24px;
    }
    .chart-card {
      padding: 10px 12px 4px;
      overflow: hidden;
    }
    .chart-card.wide {
      grid-column: 1 / -1;
    }
    .chart-card .plotly-graph-div {
      width: 100% !important;
    }
    .panel {
      padding: 18px;
      margin-bottom: 24px;
      overflow-x: auto;
    }
    .empty {
      padding: 40px 28px;
      text-align: center;
      border-style: dashed;
      margin-bottom: 24px;
    }
    .empty h2 {
      color: var(--accent);
      margin-bottom: 8px;
    }
    .empty p {
      color: var(--muted);
      margin: 0 auto;
      max-width: 620px;
    }
    code {
      background: var(--panel-alt);
      border: 1px solid var(--border);
      border-radius: 5px;
      padding: 1px 6px;
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      font-size: 12px;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
    }
    th {
      text-align: left;
      padding: 10px 12px;
      background: var(--panel-alt);
      color: var(--muted);
      font-size: 11px;
      letter-spacing: 0.07em;
      text-transform: uppercase;
      border-bottom: 1px solid var(--border);
      white-space: nowrap;
    }
    td {
      padding: 11px 12px;
      border-bottom: 1px solid rgba(48, 54, 61, 0.7);
      vertical-align: top;
    }
    tr:last-child td {
      border-bottom: 0;
    }
    td.rank {
      color: var(--muted);
      font-variant-numeric: tabular-nums;
      width: 44px;
    }
    td.cause {
      font-weight: 620;
      min-width: 150px;
    }
    td.num {
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
    }
    td.evidence {
      color: var(--muted);
      min-width: 220px;
    }
    td.action {
      min-width: 220px;
      color: #c9d1d9;
    }
    .badge {
      display: inline-block;
      padding: 2px 8px;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 650;
      letter-spacing: 0.03em;
      text-transform: uppercase;
      border: 1px solid var(--border);
      background: var(--panel-alt);
      color: var(--muted);
      white-space: nowrap;
    }
    .badge-high {
      color: var(--good);
      border-color: rgba(63, 185, 80, 0.45);
      background: rgba(63, 185, 80, 0.12);
    }
    .badge-medium {
      color: var(--warn);
      border-color: rgba(210, 153, 34, 0.45);
      background: rgba(210, 153, 34, 0.12);
    }
    .badge-low {
      color: var(--accent);
      border-color: rgba(88, 166, 255, 0.40);
      background: rgba(88, 166, 255, 0.10);
    }
    .empty-row {
      color: var(--muted);
      text-align: center;
      padding: 24px;
    }
    footer {
      color: var(--muted);
      font-size: 12px;
      text-align: center;
      margin-top: 32px;
      padding-top: 16px;
      border-top: 1px solid var(--border);
    }
    @media (max-width: 720px) {
      .wrap { padding: 20px 14px 32px; }
      h1 { font-size: 24px; }
      .charts { grid-template-columns: 1fr; }
      .chart-card.wide { grid-column: auto; }
      th, td { padding: 9px 8px; }
      td.cause, td.evidence, td.action { min-width: 140px; }
    }
  </style>
</head>
<body>
  <div class="wrap">
    <header>
      <h1>{{ title }}</h1>
      <p class="subtitle">{{ analysis.summary }}</p>
    </header>

    <section class="metrics" aria-label="Summary">
      <div class="metric">
        <div class="label">Expected runtime</div>
        <div class="value">{{ expected_runtime }}</div>
      </div>
      <div class="metric">
        <div class="label">Current power</div>
        <div class="value">{{ current_power }}</div>
      </div>
      <div class="metric">
        <div class="label">Battery health</div>
        <div class="value">{{ battery_health }}</div>
      </div>
      <div class="metric">
        <div class="label">Memory pressure</div>
        <div class="value">{{ memory_pressure }}</div>
      </div>
      <div class="metric">
        <div class="label">Window</div>
        <div class="value small">{{ window_start }}<br>to {{ window_end }}</div>
      </div>
    </section>

    {% if analysis.warnings %}
    <section class="warnings panel" aria-label="Warnings">
      <h2>Warnings</h2>
      <ul>
        {% for warning in analysis.warnings %}
        <li>{{ warning }}</li>
        {% endfor %}
      </ul>
    </section>
    {% endif %}

    {% if has_samples %}
    <section class="charts" aria-label="Charts">
      <div class="chart-card wide">{{ charts.battery | safe }}</div>
      <div class="chart-card wide">{{ charts.power | safe }}</div>
      <div class="chart-card wide">{{ charts.memory | safe }}</div>
      <div class="chart-card wide">{{ charts.apps | safe }}</div>
      <div class="chart-card wide">{{ charts.cpu | safe }}</div>
      <div class="chart-card wide">{{ charts.assertions | safe }}</div>
      {% if include_events %}
      <div class="chart-card wide">{{ charts.events | safe }}</div>
      {% endif %}
    </section>
    {% else %}
    <section class="empty" aria-label="No data">
      <h2>No samples in this window</h2>
      <p>
        There is no recorded data for this time range. Run <code>battdoctor record</code>
        to collect samples, then generate the report again.
      </p>
    </section>
    {% endif %}

    <section class="panel" aria-label="Ranked causes">
      <h2>Ranked causes</h2>
      <table>
        <thead>
          <tr>
            <th>Rank</th>
            <th>Cause</th>
            <th>Est. W</th>
            <th>Share %</th>
            <th>Confidence</th>
            <th>Evidence</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          {% for cause in analysis.causes %}
          <tr>
            <td class="rank">{{ loop.index }}</td>
            <td class="cause">{{ cause.name }}</td>
            <td class="num">
              {% if cause.estimated_w is not none %}{{ "%.2f"|format(cause.estimated_w) }}{% else %}&mdash;{% endif %}
            </td>
            <td class="num">
              {% if cause.share_pct is not none %}{{ "%.1f"|format(cause.share_pct) }}{% else %}&mdash;{% endif %}
            </td>
            <td>
              <span class="badge badge-{{ cause.confidence }}">{{ cause.confidence }}</span>
            </td>
            <td class="evidence">
              {% for item in cause.evidence %}
              <span>{{ item }}</span>{% if not loop.last %}<br>{% endif %}
              {% endfor %}
            </td>
            <td class="action">{{ cause.action }}</td>
          </tr>
          {% else %}
          <tr>
            <td class="empty-row" colspan="7">No causes identified for this window.</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </section>

    <footer>
      Generated by battdoctor on {{ generated_at }}
    </footer>
  </div>
</body>
</html>
